# Copy to .env (git-ignored); docker compose reads it automatically.

# Required — every service signs/verifies JWTs with this.
SECRET_KEY=change-me

# Required — project-service internal API (URL-safe characters only).
INTERNAL_API_PASSWORD=change-me

# Gateway host ports. Override when the default is already taken on your
# machine (e.g. a local node server on 8080 -> use 18080).
#GATEWAY_HTTPS_PORT=8443
#GATEWAY_HTTP_PORT=18080

# Gherkin import limits (test-management-service). Raise them together: the gateway's body cap
# must stay above IMPORT_MAX_TOTAL_BYTES plus JSON escaping (about 2.5x is safe).
#IMPORT_MAX_FILES=2000
#IMPORT_MAX_FILE_BYTES=262144
#IMPORT_MAX_TOTAL_BYTES=10485760
#GATEWAY_IMPORT_MAX_BODY=25m

# Running tests from QA Vision (test-management-service): the Fernet key that encrypts each project's
# GitHub token. Empty turns the feature off (Settings says so). Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# or, with the cryptography package installed:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes stored tokens unreadable: owners then save the token again in Settings.
#TM_SECRETS_KEY=

# Postgres superuser password (local stack only).
#POSTGRES_PASSWORD=postgres


# SSO (optional) — pair with the auth-service allowlist configuration.
#VITE_GOOGLE_CLIENT_ID=
#VITE_MSAL_CLIENT_ID=
#VITE_MSAL_AUTHORITY=
