"""Service layer for model training operations."""

from typing import List, Optional, Dict, Any
from sqlalchemy.orm import Session
from datetime import datetime
import uuid
import logging

from model_training.models import model as model_models
from model_training.schemas import model as model_schemas
from model_training.core.model_trainer import train_model
from model_training.core.model_evaluator import evaluate_model

# OpenTelemetry imports
from opentelemetry import trace

logger = logging.getLogger(__name__)


class ModelService:
    """Service for model operations."""

    # Tracer for distributed tracing
    tracer = trace.get_tracer(__name__)

    @staticmethod
    def create_model(db: Session, model_data: model_schemas.ModelCreate, created_by: Optional[str] = None) -> model_models.Model:
        """Create a new model."""
        with ModelService.tracer.start_as_current_span("create_model") as span:
            model_dict = model_data.dict()
            if created_by:
                model_dict["created_by"] = created_by

            db_model = model_models.Model(**model_dict)
            db.add(db_model)
            db.commit()
            db.refresh(db_model)

            # Add attributes to the span
            span.set_attribute("model.id", str(db_model.id))
            span.set_attribute("model.name", db_model.name)
            span.set_attribute("model.type", db_model.model_type)

            return db_model

    @staticmethod
    def get_model(db: Session, model_id: str) -> Optional[model_models.Model]:
        """Get a model by ID."""
        with ModelService.tracer.start_as_current_span("get_model") as span:
            model = db.query(model_models.Model).filter(model_models.Model.id == model_id).first()

            # Add attributes to the span
            span.set_attribute("model.id", model_id)
            if model is not None:
                span.set_attribute("model.found", True)
                span.set_attribute("model.name", model.name)
            else:
                span.set_attribute("model.found", False)

            return model

    @staticmethod
    def get_models(db: Session, skip: int = 0, limit: int = 100, model_type: Optional[str] = None, status: Optional[str] = None) -> List[model_models.Model]:
        """Get a list of models with optional filtering."""
        with ModelService.tracer.start_as_current_span("get_models") as span:
            query = db.query(model_models.Model)

            if model_type:
                query = query.filter(model_models.Model.model_type == model_type)

            if status:
                query = query.filter(model_models.Model.status == status)

            # Add pagination info to span
            span.set_attribute("query.skip", skip)
            span.set_attribute("query.limit", limit)
            if model_type:
                span.set_attribute("query.model_type", model_type)
            if status:
                span.set_attribute("query.status", status)

            result = query.offset(skip).limit(limit).all()

            # Add result count to span
            span.set_attribute("result.count", len(result))

            return result

    @staticmethod
    def update_model(db: Session, model_id: str, model_data: model_schemas.ModelUpdate) -> Optional[model_models.Model]:
        """Update a model."""
        with ModelService.tracer.start_as_current_span("update_model") as span:
            db_model = ModelService.get_model(db, model_id)
            if not db_model:
                span.set_attribute("model.found", False)
                return None

            # Add attributes to the span
            span.set_attribute("model.id", model_id)
            span.set_attribute("model.found", True)

            update_data = model_data.dict(exclude_unset=True)
            for field, value in update_data.items():
                setattr(db_model, field, value)

            db_model.updated_at = datetime.utcnow()
            db.commit()
            db.refresh(db_model)
            return db_model

    @staticmethod
    def delete_model(db: Session, model_id: str) -> bool:
        """Delete a model."""
        with ModelService.tracer.start_as_current_span("delete_model") as span:
            db_model = ModelService.get_model(db, model_id)
            if not db_model:
                span.set_attribute("model.found", False)
                return False

            # Add attributes to the span
            span.set_attribute("model.id", model_id)
            span.set_attribute("model.found", True)

            db.delete(db_model)
            db.commit()
            return True

    @staticmethod
    def train_model(db: Session, model_id: str, initiated_by: Optional[str] = None) -> str:
        """Start training a model."""
        with ModelService.tracer.start_as_current_span("train_model") as span:
            # Get the model
            model = ModelService.get_model(db, model_id)
            if not model:
                span.set_attribute("model.found", False)
                raise ValueError(f"Model {model_id} not found")

            # Add attributes to the span
            span.set_attribute("model.id", model_id)
            span.set_attribute("model.found", True)
            span.set_attribute("model.name", model.name)

            # Update status to training
            model.status = "training"
            if initiated_by:
                # We don't have a field for who initiated training, but we could add it to training job
                pass
            model.updated_at = datetime.utcnow()
            db.commit()

            # Generate training job ID
            training_job_id = str(uuid.uuid4())

            # Create training job record
            training_job = model_models.TrainingJob(
                id=training_job_id,
                model_id=model_id,
                status="queued"
            )
            db.add(training_job)
            db.commit()

            # Add training job ID to span
            span.set_attribute("training.job.id", training_job_id)

            # Start training in background (this would be handled by a task queue in production)
            # For now, we'll simulate by calling the trainer function directly
            # In a real implementation, this would be offloaded to a worker process
            try:
                # Send training request to Kafka
                from model_training.infrastructure.messaging.kafka_producer import KafkaProducerWrapper
                producer = KafkaProducerWrapper()

                # Prepare training request data
                training_request = {
                    "model_id": model_id,
                    "training_job_id": training_job_id,
                    "training_config": model.training_config or {},
                    "initiated_by": initiated_by
                }

                # Send to Kafka
                producer.send_model_training_request(training_request)
                producer.close()

                # Start actual training (would be done by worker in production)
                train_model(model_id, training_job_id, model.training_config or {}, db)
            except Exception as e:
                # Update training job status on failure
                training_job.status = "failed"
                training_job.updated_at = datetime.utcnow()
                db.commit()
                span.record_exception(e)
                span.set_status(trace.StatusCode.ERROR, str(e))
                raise e

            return training_job_id

    @staticmethod
    def evaluate_model(db: Session, model_id: str, evaluation_config: Dict[str, Any], initiated_by: Optional[str] = None) -> str:
        """Start evaluating a model."""
        with ModelService.tracer.start_as_current_span("evaluate_model") as span:
            # Get the model
            model = ModelService.get_model(db, model_id)
            if not model:
                span.set_attribute("model.found", False)
                raise ValueError(f"Model {model_id} not found")

            # Add attributes to the span
            span.set_attribute("model.id", model_id)
            span.set_attribute("model.found", True)
            span.set_attribute("model.name", model.name)

            # Generate evaluation ID
            evaluation_id = str(uuid.uuid4())

            # Create evaluation record
            evaluation = model_models.ModelEvaluation(
                id=evaluation_id,
                model_id=model_id,
                evaluation_type="standard",  # Default, could be made configurable
                status="pending",
                metrics=None,
                dataset_info=None
            )
            db.add(evaluation)
            db.commit()

            # Add evaluation ID to span
            span.set_attribute("evaluation.id", evaluation_id)

            # Start evaluation in background
            try:
                # Send evaluation request to Kafka
                from model_training.infrastructure.messaging.kafka_producer import KafkaProducerWrapper
                producer = KafkaProducerWrapper()

                # Prepare evaluation request data
                evaluation_request = {
                    "model_id": model_id,
                    "evaluation_id": evaluation_id,
                    "evaluation_config": evaluation_config,
                    "initiated_by": initiated_by
                }

                # Send to Kafka
                producer.send_model_evaluation_request(evaluation_request)
                producer.close()

                # Start actual evaluation (would be done by worker in production)
                evaluate_model(model_id, evaluation_id, evaluation_config, db)
            except Exception as e:
                # Update evaluation status on failure
                evaluation.status = "failed"
                # We don't have an error_message field, but we could add one
                evaluation.updated_at = datetime.utcnow()
                db.commit()
                span.record_exception(e)
                span.set_status(trace.StatusCode.ERROR, str(e))
                raise e

            return evaluation_id

    @staticmethod
    def deploy_model(db: Session, model_id: str, deployed_by: Optional[str] = None) -> model_models.Model:
        """Deploy a model."""
        with ModelService.tracer.start_as_current_span("deploy_model") as span:
            db_model = ModelService.get_model(db, model_id)
            if not db_model:
                span.set_attribute("model.found", False)
                raise ValueError(f"Model {model_id} not found")

            # Add attributes to the span
            span.set_attribute("model.id", model_id)
            span.set_attribute("model.found", True)
            span.set_attribute("model.name", db_model.name)

            if db_model.status != "completed":
                span.set_attribute("model.status", db_model.status)
                raise ValueError(f"Model {model_id} must be completed before deployment")

            db_model.status = "deployed"
            db_model.is_active = True
            if deployed_by:
                # We don't have a field for who deployed, but we could add it or log it
                pass
            db_model.deployed_at = datetime.utcnow()
            db_model.updated_at = datetime.utcnow()
            db.commit()
            db.refresh(db_model)

            # Add deployment attributes to span
            span.set_attribute("model.status.after", "deployed")
            span.set_attribute("model.is_active", True)

            return db_model

    @staticmethod
    def deploy_model_version(db: Session, model_id: str, version: str, deployed_by: Optional[str] = None) -> model_models.Model:
        """Deploy a specific model version."""
        with ModelService.tracer.start_as_current_span("deploy_model_version") as span:
            # Get the specific model version
            model = db.query(model_models.Model).filter(
                model_models.Model.id == model_id,
                model_models.Model.version == version
            ).first()

            if not model:
                span.set_attribute("model.found", False)
                raise ValueError(f"Model {model_id} version {version} not found")

            # Add attributes to the span
            span.set_attribute("model.id", model_id)
            span.set_attribute("model.version", version)
            span.set_attribute("model.found", True)
            span.set_attribute("model.name", model.name)

            # Check if model is completed before deployment
            if model.status != "completed":
                span.set_attribute("model.status", model.status)
                raise ValueError(f"Model {model_id} version {version} must be completed before deployment")

            # Deactivate all other versions of this model
            db.query(model_models.Model).filter(
                model_models.Model.id == model_id
            ).update({model_models.Model.is_active: False})

            # Activate this version
            model.is_active = True
            model.status = "deployed"
            if deployed_by:
                # We don't have a field for who deployed, but we could add it or log it
                pass
            model.updated_at = datetime.utcnow()

            db.commit()
            db.refresh(model)

            # Add deployment attributes to span
            span.set_attribute("model.status.after", "deployed")
            span.set_attribute("model.is_active", True)

            # Send model trained event to Kafka
            try:
                from model_training.infrastructure.messaging.kafka_producer import KafkaProducerWrapper
                producer = KafkaProducerWrapper()

                # Prepare model trained event data
                model_trained_event = {
                    "id": str(model.id),
                    "name": model.name,
                    "version": model.version,
                    "model_type": model.model_type,
                    "status": model.status,
                    "deployed_at": model.deployed_at.isoformat() if model.deployed_at else None,
                    "deployed_by": deployed_by
                }

                # Send to Kafka
                producer.send_model_trained_event(model_trained_event)
                producer.close()
            except Exception as e:
                # Log error but don't fail the deployment
                logger.warning(f"Failed to send model trained event to Kafka: {e}")

            return model

    @staticmethod
    def retire_model(db: Session, model_id: str, retired_by: Optional[str] = None) -> model_models.Model:
        """Retire a model."""
        with ModelService.tracer.start_as_current_span("retire_model") as span:
            db_model = ModelService.get_model(db, model_id)
            if not db_model:
                span.set_attribute("model.found", False)
                raise ValueError(f"Model {model_id} not found")

            # Add attributes to the span
            span.set_attribute("model.id", model_id)
            span.set_attribute("model.found", True)
            span.set_attribute("model.name", db_model.name)

            db_model.status = "retired"
            db_model.is_active = False
            if retired_by:
                # We don't have a field for who retired, but we could add it or log it
                pass
            db_model.updated_at = datetime.utcnow()
            db.commit()
            db.refresh(db_model)

            # Add retirement attributes to span
            span.set_attribute("model.status.after", "retired")
            span.set_attribute("model.is_active", False)

            return db_model

    @staticmethod
    def get_model_versions(db: Session, model_id: str) -> List[model_models.ModelVersion]:
        """Get all versions of a model."""
        with ModelService.tracer.start_as_current_span("get_model_versions") as span:
            # Add attributes to the span
            span.set_attribute("model.id", model_id)

            versions = db.query(model_models.ModelVersion).filter(
                model_models.ModelVersion.model_id == model_id
            ).all()

            # Add result count to span
            span.set_attribute("result.count", len(versions))

            return versions

    @staticmethod
    def get_model_evaluations(db: Session, model_id: str) -> List[model_models.ModelEvaluation]:
        """Get all evaluations of a model."""
        with ModelService.tracer.start_as_current_span("get_model_evaluations") as span:
            # Add attributes to the span
            span.set_attribute("model.id", model_id)

            evaluations = db.query(model_models.ModelEvaluation).filter(
                model_models.ModelEvaluation.model_id == model_id
            ).all()

            # Add result count to span
            span.set_attribute("result.count", len(evaluations))

            return evaluations

    @staticmethod
    def get_model_evaluation(db: Session, evaluation_id: str) -> Optional[model_models.ModelEvaluation]:
        """Get a specific evaluation by ID."""
        with ModelService.tracer.start_as_current_span("get_model_evaluation") as span:
            # Add attributes to the span
            span.set_attribute("evaluation.id", evaluation_id)

            evaluation = db.query(model_models.ModelEvaluation).filter(
                model_models.ModelEvaluation.id == evaluation_id
            ).first()

            # Add attributes to the span
            if evaluation is not None:
                span.set_attribute("evaluation.found", True)
                span.set_attribute("evaluation.model_id", str(evaluation.model_id))
            else:
                span.set_attribute("evaluation.found", False)

            return evaluation