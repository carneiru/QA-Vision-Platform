"""Model Training API endpoints."""

from fastapi import APIRouter, Depends, HTTPException, BackgroundTasks, status, Response
from fastapi.responses import JSONResponse
from sqlalchemy.orm import Session
from typing import List, Optional
import uuid
from datetime import datetime
import time
from prometheus_client import Counter, Histogram, Gauge, generate_latest, CONTENT_TYPE_LATEST

from model_training.db import get_db
from model_training.models import model as model_models
from model_training.schemas import model as model_schemas
from model_training.service import model_service
from model_training.auth import get_current_user, require_role, require_any_role

# Create database tables
from model_training.db import engine
model_models.Base.metadata.create_all(bind=engine)

# Prometheus metrics
REQUEST_COUNT = Counter(
    'model_training_requests_total',
    'Total number of requests to the model training API',
    ['method', 'endpoint', 'http_status']
)

REQUEST_LATENCY = Histogram(
    'model_training_request_duration_seconds',
    'Request latency in seconds',
    ['method', 'endpoint']
)

TRAINING_JOBS_TOTAL = Counter(
    'model_training_training_jobs_total',
    'Total number of training jobs',
    ['status']  # completed, failed, etc.
)

TRAINING_JOB_DURATION = Histogram(
    'model_training_training_job_duration_seconds',
    'Duration of training jobs in seconds'
)

ACTIVE_MODELS = Gauge(
    'model_training_active_models',
    'Number of active models in the system',
    ['status']  # training, trained, evaluating, deployed, etc.
)

MODEL_EVALUATIONS_TOTAL = Counter(
    'model_training_model_evaluations_total',
    'Total number of model evaluations',
    ['status']  # completed, failed, etc.
)

router = APIRouter()


@router.post("/", response_model=model_schemas.ModelResponse, status_code=status.HTTP_201_CREATED)
async def register_model(
    model_data: model_schemas.ModelCreate,
    background_tasks: BackgroundTasks,
    db: Session = Depends(get_db),
    current_user: dict = Depends(get_current_user)
):
    """
    Register a new ML model for training.

    This endpoint creates a new model record and initiates the training process
    in the background.
    """
    start_time = time.time()
    try:
        # Create model record using service
        db_model = model_service.ModelService.create_model(db, model_data, current_user.get("sub"))

        # Start training in background
        background_tasks.add_task(
            model_service.ModelService.train_model,
            db_model.id,
            current_user.get("sub"),
            db
        )

        # Record success metrics
        REQUEST_COUNT.labels(method="POST", endpoint="/", http_status="201").inc()
        REQUEST_LATENCY.labels(method="POST", endpoint="/").observe(time.time() - start_time)

        return db_model
    except Exception as e:
        # Record error metrics
        REQUEST_COUNT.labels(method="POST", endpoint="/", http_status="500").inc()
        REQUEST_LATENCY.labels(method="POST", endpoint="/").observe(time.time() - start_time)
        raise e


@router.get("/{model_id}", response_model=model_schemas.ModelResponse)
async def get_model(model_id: str, db: Session = Depends(get_db), current_user: dict = Depends(get_current_user)):
    """
    Get model details and metadata by ID.
    """
    start_time = time.time()
    try:
        model = model_service.ModelService.get_model(db, model_id)
        if not model:
            REQUEST_COUNT.labels(method="GET", endpoint="/{model_id}", http_status="404").inc()
            REQUEST_LATENCY.labels(method="GET", endpoint="/{model_id}").observe(time.time() - start_time)
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Model with ID {model_id} not found"
            )

        # Record success metrics
        REQUEST_COUNT.labels(method="GET", endpoint="/{model_id}", http_status="200").inc()
        REQUEST_LATENCY.labels(method="GET", endpoint="/{model_id}").observe(time.time() - start_time)

        return model
    except Exception as e:
        # Record error metrics
        REQUEST_COUNT.labels(method="GET", endpoint="/{model_id}", http_status="500").inc()
        REQUEST_LATENCY.labels(method="GET", endpoint="/{model_id}").observe(time.time() - start_time)
        raise e


@router.put("/{model_id}/version/{version}", response_model=model_schemas.ModelResponse)
async def deploy_model_version(
    model_id: str,
    version: str,
    db: Session = Depends(get_db),
    current_user: dict = Depends(require_role("trainer"))  # Only trainers can deploy
):
    """
    Deploy a specific model version.

    This endpoint marks a specific model version as active/production.
    """
    start_time = time.time()
    try:
        # Deploy model version using service
        model = model_service.ModelService.deploy_model_version(
            db,
            model_id,
            version,
            current_user.get("sub")
        )

        if not model:
            REQUEST_COUNT.labels(method="PUT", endpoint="/{model_id}/version/{version}", http_status="404").inc()
            REQUEST_LATENCY.labels(method="PUT", endpoint="/{model_id}/version/{version}").observe(time.time() - start_time)
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Model {model_id} version {version} not found"
            )

        # Record success metrics
        REQUEST_COUNT.labels(method="PUT", endpoint="/{model_id}/version/{version}", http_status="200").inc()
        REQUEST_LATENCY.labels(method="PUT", endpoint="/{model_id}/version/{version}").observe(time.time() - start_time)

        return model
    except Exception as e:
        # Record error metrics
        REQUEST_COUNT.labels(method="PUT", endpoint="/{model_id}/version/{version}", http_status="500").inc()
        REQUEST_LATENCY.labels(method="PUT", endpoint="/{model_id}/version/{version}").observe(time.time() - start_time)
        raise e


@router.post("/{model_id}/evaluate", response_model=model_schemas.ModelEvaluationResponse)
async def evaluate_model(
    model_id: str,
    evaluation_request: model_schemas.ModelEvaluationRequest,
    background_tasks: BackgroundTasks,
    db: Session = Depends(get_db),
    current_user: dict = Depends(require_any_role(["trainer", "evaluator"]))  # Trainers and evaluators can run evaluations
):
    """
    Run model evaluation against a test dataset.

    This endpoint triggers model evaluation and returns the results.
    """
    start_time = time.time()
    try:
        # Start evaluation using service
        evaluation_id = model_service.ModelService.evaluate_model(
            db,
            model_id,
            evaluation_request.evaluation_config or {},
            current_user.get("sub")
        )

        # Get the evaluation record to return in response
        evaluation = model_service.ModelService.get_model_evaluation(db, evaluation_id)
        if not evaluation:
            REQUEST_COUNT.labels(method="POST", endpoint="/{model_id}/evaluate", http_status="500").inc()
            REQUEST_LATENCY.labels(method="POST", endpoint="/{model_id}/evaluate").observe(time.time() - start_time)
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Failed to create evaluation record"
            )

        # Record success metrics
        REQUEST_COUNT.labels(method="POST", endpoint="/{model_id}/evaluate", http_status="200").inc()
        REQUEST_LATENCY.labels(method="POST", endpoint="/{model_id}/evaluate").observe(time.time() - start_time)

        return model_schemas.ModelEvaluationResponse(
            evaluation_id=evaluation.id,
            model_id=model_id,
            status=evaluation.status,
            started_at=evaluation.started_at
        )
    except ValueError as e:
        # Handle model not found error
        REQUEST_COUNT.labels(method="POST", endpoint="/{model_id}/evaluate", http_status="404").inc()
        REQUEST_LATENCY.labels(method="POST", endpoint="/{model_id}/evaluate").observe(time.time() - start_time)
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=str(e)
        )
    except Exception as e:
        # Record error metrics
        REQUEST_COUNT.labels(method="POST", endpoint="/{model_id}/evaluate", http_status="500").inc()
        REQUEST_LATENCY.labels(method="POST", endpoint="/{model_id}/evaluate").observe(time.time() - start_time)
        raise e


@router.delete("/{model_id}", status_code=status.HTTP_204_NO_CONTENT)
async def retire_model(
    model_id: str,
    db: Session = Depends(get_db),
    current_user: dict = Depends(require_role("admin"))  # Only admins can retire models
):
    """
    Retire a model version.

    This endpoint marks a model as retired/deprecated.
    """
    start_time = time.time()
    try:
        # Retire the model using service
        model_service.ModelService.retire_model(
            db,
            model_id,
            current_user.get("sub")
        )

        # Record success metrics
        REQUEST_COUNT.labels(method="DELETE", endpoint="/{model_id}", http_status="204").inc()
        REQUEST_LATENCY.labels(method="DELETE", endpoint="/{model_id}").observe(time.time() - start_time)

        return None
    except Exception as e:
        # Record error metrics
        REQUEST_COUNT.labels(method="DELETE", endpoint="/{model_id}", http_status="500").inc()
        REQUEST_LATENCY.labels(method="DELETE", endpoint="/{model_id}").observe(time.time() - start_time)
        raise e


@router.get("/", response_model=List[model_schemas.ModelResponse])
async def list_models(
    skip: int = 0,
    limit: int = 100,
    model_type: Optional[str] = None,
    status: Optional[str] = None,
    db: Session = Depends(get_db),
    current_user: dict = Depends(get_current_user)
):
    """
    List models with optional filtering.
    """
    start_time = time.time()
    try:
        models = model_service.ModelService.get_models(
            db,
            skip=skip,
            limit=limit,
            model_type=model_type,
            status=status
        )

        # Record success metrics
        REQUEST_COUNT.labels(method="GET", endpoint="/", http_status="200").inc()
        REQUEST_LATENCY.labels(method="GET", endpoint="/").observe(time.time() - start_time)

        return models
    except Exception as e:
        # Record error metrics
        REQUEST_COUNT.labels(method="GET", endpoint="/", http_status="500").inc()
        REQUEST_LATENCY.labels(method="GET", endpoint="/").observe(time.time() - start_time)
        raise e


@router.get("/{model_id}/versions", response_model=List[model_schemas.ModelResponse])
async def get_model_versions(model_id: str, db: Session = Depends(get_db), current_user: dict = Depends(get_current_user)):
    """
    Get all versions of a specific model.
    """
    start_time = time.time()
    try:
        models = model_service.ModelService.get_model_versions(db, model_id)

        if not models:
            REQUEST_COUNT.labels(method="GET", endpoint="/{model_id}/versions", http_status="404").inc()
            REQUEST_LATENCY.labels(method="GET", endpoint="/{model_id}/versions").observe(time.time() - start_time)
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"No versions found for model {model_id}"
            )

        # Record success metrics
        REQUEST_COUNT.labels(method="GET", endpoint="/{model_id}/versions", http_status="200").inc()
        REQUEST_LATENCY.labels(method="GET", endpoint="/{model_id}/versions").observe(time.time() - start_time)

        return models
    except Exception as e:
        # Record error metrics
        REQUEST_COUNT.labels(method="GET", endpoint="/{model_id}/versions", http_status="500").inc()
        REQUEST_LATENCY.labels(method="GET", endpoint="/{model_id}/versions").observe(time.time() - start_time)
        raise e


@router.get("/{model_id}/evaluations", response_model=List[model_schemas.ModelEvaluationResponse])
async def get_model_evaluations(
    model_id: str,
    db: Session = Depends(get_db),
    current_user: dict = Depends(get_current_user)
):
    """Get all evaluations of an ML model."""
    start_time = time.time()
    try:
        # Check if model exists
        db_model = model_service.ModelService.get_model(db, model_id)
        if db_model is None:
            REQUEST_COUNT.labels(method="GET", endpoint="/{model_id}/evaluations", http_status="404").inc()
            REQUEST_LATENCY.labels(method="GET", endpoint="/{model_id}/evaluations").observe(time.time() - start_time)
            raise HTTPException(status_code=404, detail="Model not found")

        evaluations = model_service.ModelService.get_model_evaluations(db, model_id)

        # Record success metrics
        REQUEST_COUNT.labels(method="GET", endpoint="/{model_id}/evaluations", http_status="200").inc()
        REQUEST_LATENCY.labels(method="GET", endpoint="/{model_id}/evaluations").observe(time.time() - start_time)

        return evaluations
    except Exception as e:
        # Record error metrics
        REQUEST_COUNT.labels(method="GET", endpoint="/{model_id}/evaluations", http_status="500").inc()
        REQUEST_LATENCY.labels(method="GET", endpoint="/{model_id}/evaluations").observe(time.time() - start_time)
        raise e


@router.get("/metrics")
async def metrics():
    """Prometheus metrics endpoint."""
    return Response(
        content=generate_latest(),
        media_type=CONTENT_TYPE_LATEST
    )


@router.get("/health/live")
async def liveness_probe():
    """Liveness probe endpoint for Kubernetes.
    Returns 200 OK if the service is running.
    """
    return {"status": "alive"}


@router.get("/health/ready")
async def readiness_probe(db: Session = Depends(get_db)):
    """Readiness probe endpoint for Kubernetes.
    Checks if the service is ready to handle requests by verifying
    dependencies like database connectivity.
    """
    try:
        # Check database connectivity
        db.execute("SELECT 1")
        return {"status": "ready"}
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
            detail=f"Service not ready: {str(e)}"
        )


@router.get("/health")
async def health_check(db: Session = Depends(get_db)):
    """Health check endpoint providing overall service status.
    Checks dependencies and returns detailed health information.
    """
    health_status = {
        "status": "healthy",
        "timestamp": datetime.utcnow().isoformat(),
        "version": settings.VERSION,
        "checks": {}
    }

    # Check database
    try:
        db.execute("SELECT 1")
        health_status["checks"]["database"] = {"status": "healthy"}
    except Exception as e:
        health_status["checks"]["database"] = {"status": "unhealthy", "error": str(e)}
        health_status["status"] = "unhealthy"

    # Check Kafka (basic check - just see if we can produce to it)
    try:
        from model_training.infrastructure.messaging.kafka_producer import KafkaProducerWrapper
        producer = KafkaProducerWrapper()
        # Just instantiate the producer to check if config is valid
        producer.close()
        health_status["checks"]["kafka"] = {"status": "healthy"}
    except Exception as e:
        health_status["checks"]["kafka"] = {"status": "unhealthy", "error": str(e)}
        health_status["status"] = "degraded"  # Kafka is not critical for basic operation

    # Determine HTTP status based on health
    status_code = status.HTTP_200_OK if health_status["status"] == "healthy" else status.HTTP_503_SERVICE_UNAVAILABLE

    return JSONResponse(content=health_status, status_code=status_code)


@router.get("/metrics")
async def metrics():
    """Prometheus metrics endpoint."""
    return Response(
        content=generate_latest(),
        media_type=CONTENT_TYPE_LATEST
    )