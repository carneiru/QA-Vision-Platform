# .env.example
# Environment variables for the Authentication Service

# Application
APP_NAME=Auth Service
APP_VERSION=0.1.0
DEBUG=False

# API
API_V1_STR=/api/v1

# Security
SECRET_KEY=your-super-secret-key-change-in-production
# Access tokens cannot be revoked, so this is the revocation delay; keep it short.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auth_db
# DATABASE=auth_db
# If you want to set DATABASE_URL directly, you can do so and the other POSTGRES_* variables will be ignored
# DATABASE_URL=postgresql://postgres:password@localhost:5432/auth_db

# Redis (for token blacklisting, optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# SMTP for email verification
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAILS_FROM_EMAIL=no-reply@example.com
EMAILS_FROM_NAME=Example App

# SSO Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SAML_SETTINGS={}

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]